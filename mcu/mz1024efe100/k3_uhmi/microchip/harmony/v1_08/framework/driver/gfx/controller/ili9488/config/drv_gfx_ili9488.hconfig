menu "ILI9488"

config USE_DRV_GFX_ILI9488_NEEDED
    bool

config USE_DRV_GFX_ILI9488
    bool "Use ILI9488 Driver?"
    select DRIVER
    select USE_DRV_PMP_NEEDED
    default n if !USE_DRV_GFX_ILI9488_NEEDED
    default y if USE_DRV_GFX_ILI9488_NEEDED
    ---help---
     IDH_HTML_Graphics_Driver_Library
    ---endhelp---


endmenu

ifblock USE_DRV_GFX_ILI9488

add "<#include \"/framework/driver/gfx/controller/config/drv_gfx_init_data.c.ftl\">"  to list SYSTEM_INIT_C_DRIVER_INITIALIZATION_DATA
add "<#include \"/framework/driver/gfx/controller/ili9488/config/drv_gfx_ili9488_init.c.ftl\">"  to list SYSTEM_INIT_C_SYS_INITIALIZE_DRIVERS

file DRV_GFX_ILI9488_H "$HARMONY_VERSION_PATH/framework/driver/gfx/controller/ili9488/drv_gfx_ili9488.h" to "$PROJECT_HEADER_FILES/framework/driver/gfx/controller/gfx_ili9488/drv_gfx_ili9488.h"
file DRV_GFX_CTRL_ILI9488_H "$HARMONY_VERSION_PATH/framework/driver/gfx/controller/drv_gfx_controller.h" to "$PROJECT_HEADER_FILES/framework/driver/gfx/controller/drv_gfx_controller.h"
file DRV_GFX_COMMON_ILI9488_H "$HARMONY_VERSION_PATH/framework/driver/gfx/gfx_common.h" to "$PROJECT_HEADER_FILES/framework/driver/gfx/gfx_common.h"
file DRV_GFX_ILI9488_C "$HARMONY_VERSION_PATH/framework/driver/gfx/controller/ili9488/src/drv_gfx_ili9488.c" to "$PROJECT_SOURCE_FILES/framework/driver/gfx/controller/gfx_ili9488/src/drv_gfx_ili9488.c"
endif
